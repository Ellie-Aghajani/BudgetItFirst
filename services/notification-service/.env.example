# Copy to .env for `npm run dev` (outside Docker). Never commit .env.
NODE_ENV=development
PORT=8081
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27018
MONGODB_DB=notifications
RABBITMQ_URI=amqp://budget:change-me@localhost:5672
# "dev" skips token checks (refused when NODE_ENV=production).
AUTH_MODE=dev
# Put your Firebase UID here so you see the notifications the .NET API creates for you.
DEV_USER_ID=dev-user
FIREBASE_PROJECT_ID=todo-85812
# Optional, only needed for admin features. Paste the JSON on one line.
# FIREBASE_CREDENTIALS_JSON=
